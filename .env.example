# Copy to .env, fill in locally, then restart Flask. Never commit your .env file.
# Leave SMTP_HOST blank to save local email previews without sending messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# For SMTPS (usually port 465), set SMTP_SECURITY=ssl and SMTP_PORT=465.
# Public or LAN address reachable by applicants; used in confirmation links.
SERBISYOQ_PUBLIC_URL=
# Optional private demonstration settings:
# SERBISYOQ_STAFF_PASSWORD=
# SERBISYOQ_SECRET_KEY=
